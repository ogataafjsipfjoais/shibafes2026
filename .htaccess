DirectoryIndex index.html
Options -Indexes
AddType model/gltf-binary .glb
AddType image/webp .webp
AddType font/woff2 .woff2
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /shibafes2026/
RewriteRule ^access/?$ access/index.html [L]
</IfModule>
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript text/javascript application/json application/ld+json application/xml text/xml image/svg+xml model/gltf-binary
</IfModule>
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Content-Security-Policy "object-src 'none'; base-uri 'self'; frame-ancestors 'self'"
<FilesMatch "\.(html|json|js|css|xml)$">
Header set Cache-Control "no-cache"
</FilesMatch>
<FilesMatch "\.(webp|png|svg|glb|woff2)$">
Header set Cache-Control "public, max-age=86400"
</FilesMatch>
</IfModule>
